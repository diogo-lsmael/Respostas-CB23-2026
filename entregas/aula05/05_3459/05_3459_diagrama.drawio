        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Hierarquia de Pessoas\n    class Pessoa {\n        +nome: str\n        +idade: int\n    }\n    class Funcionario {\n        +salario: float\n        +carga_horaria: int\n    }\n    class Garcom {\n        +anotar_pedido(pedido: Pedido)\n    }\n    class ChefeDeCozinha {\n        +preparar(item: Iguaria)\n    }\n    class Gerente {\n        +demitir(funcionario: Funcionario)\n    }\n    \n    Pessoa &lt;|-- Funcionario\n    Funcionario &lt;|-- Garcom\n    Funcionario &lt;|-- ChefeDeCozinha\n    Funcionario &lt;|-- Gerente\n\n    %% Hierarquia de Restaurante\n    class Restaurante {\n        +nome: str\n        +endereco: str\n        +telefone: str\n    }\n    class Pizzaria {\n        +rodizio: bool\n    }\n    \n    Restaurante &lt;|-- Pizzaria\n\n    %% Hierarquia de Iguaria\n    class Iguaria {\n        +nome: str\n        +preco: float\n    }\n    class Pizza {\n        +borda_recheada: bool\n    }\n    class Bolo {\n        +formato: str\n    }\n    \n    Iguaria &lt;|-- Pizza\n    Iguaria &lt;|-- Bolo\n\n    %% Novas Classes e Associações (Questões 2 e 3)\n    class Cardapio {\n        +adicionarIguaria()\n        +removerIguaria()\n    }\n    class Pedido {\n        +mesa: int\n    }\n\n    Restaurante \&quot;1\&quot; *-- \&quot;1\&quot; Cardapio : compõe\n    Cardapio \&quot;1\&quot; o-- \&quot;*\&quot; Iguaria : contém\n    Pedido \&quot;*\&quot; o-- \&quot;*\&quot; Iguaria : possui\n    Garcom ..&gt; Pedido : anota\n    ChefeDeCozinha ..&gt; Pedido : prepara&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QC6LCipKOugw8OYVPEb_-1">
